<?xml version="1.0" encoding="UTF-8"?>
<archetype-descriptor
        xmlns="http://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.2.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.2.0 https://maven.apache.org/xsd/archetype-descriptor-1.2.0.xsd"
        name="maven-c-native-single-archetype">
    <fileSets>
        <fileSet filtered="true" packaged="false">
            <includes>
                <include>CMakeLists.txt</include>
                <include>README.md</include>
                <include>.gitignore</include>
                <include>.clang-format</include>
            </includes>
        </fileSet>
        <fileSet filtered="false" packaged="false">
            <directory>.mvn</directory>
            <includes>
                <include>jvm.config</include>
            </includes>
        </fileSet>
        <fileSet filtered="false" packaged="false">
            <directory>src/main/include</directory>
            <includes>
                <include>**/*.h</include>
            </includes>
        </fileSet>
        <fileSet filtered="false" packaged="false">
            <directory>src/main/c</directory>
            <includes>
                <include>**/*.c</include>
            </includes>
        </fileSet>
        <fileSet filtered="false" packaged="false">
            <directory>src/main/resources</directory>
            <includes>
                <include>**/*</include>
            </includes>
        </fileSet>
        <fileSet filtered="false" packaged="false">
            <directory>src/test/c</directory>
            <includes>
                <include>**/*.c</include>
            </includes>
        </fileSet>
        <fileSet filtered="false" packaged="false">
            <directory>src/test/resources</directory>
            <includes>
                <include>**/*</include>
            </includes>
        </fileSet>
    </fileSets>
</archetype-descriptor>
